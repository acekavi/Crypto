# ENA/XRP statistical arbitrage testnet bot

[Unit]
Description=Crypto pairs bot (Bybit testnet, ENA/XRP statistical arbitrage)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/var/home/acekavi/Projects/Crypto
EnvironmentFile=/var/home/acekavi/Projects/Crypto/.env
ExecStart=/usr/bin/python3 /var/home/acekavi/Projects/Crypto/scripts/pairs_bot.py live --env /var/home/acekavi/Projects/Crypto/.env --state /var/home/acekavi/Projects/Crypto/data/pairs_bot_ena_xrp_state.json --loop-seconds 60 --log-file /var/home/acekavi/Projects/Crypto/logs/pairs-bot-ena-xrp.log --bot-id ena_xrp --leg-a ENAUSDT --leg-b XRPUSDT --timeframe 60 --rolling-window 336 --entry-z 3.25 --stop-z 4.5 --target-z -0.5 --max-hold-bars 96 --fee-per-leg 0.0002 --per-leg-notional-usdt 25 --risk-pct-of-equity 0.03 --cap-per-leg-to-available-equity true --enable-breakeven false --breakeven-r-multiple 2
Restart=always
RestartSec=10s
NoNewPrivileges=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=crypto-bot-ena-xrp

[Install]
WantedBy=default.target
