# LINK/XRP statistical arbitrage testnet bot

[Unit]
Description=Crypto pairs bot (Bybit testnet, LINK/XRP statistical arbitrage)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/var/home/acekavi/Projects/Crypto
EnvironmentFile=/var/home/acekavi/Projects/Crypto/.env
ExecStart=/usr/bin/python3 /var/home/acekavi/Projects/Crypto/scripts/pairs_bot.py live --env /var/home/acekavi/Projects/Crypto/.env --state /var/home/acekavi/Projects/Crypto/data/pairs_bot_link_xrp_state.json --loop-seconds 60 --log-file /var/home/acekavi/Projects/Crypto/logs/pairs-bot-link-xrp.log --leg-a LINKUSDT --leg-b XRPUSDT --timeframe 60 --rolling-window 240 --entry-z 3.5 --stop-z 4.5 --target-z 0.5 --max-hold-bars 72 --fee-per-leg 0.0002 --per-leg-notional-usdt 25
Restart=always
RestartSec=10s
NoNewPrivileges=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=crypto-bot-link-xrp

[Install]
WantedBy=default.target
