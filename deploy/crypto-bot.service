# DOGE/XRP statistical arbitrage testnet bot
# Replaces the old single-symbol ICT bot when installed as the user service.

[Unit]
Description=Crypto pairs bot (Bybit testnet, DOGE/XRP statistical arbitrage)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/var/home/acekavi/Projects/Crypto
EnvironmentFile=/var/home/acekavi/Projects/Crypto/.env
ExecStart=/usr/bin/python3 /var/home/acekavi/Projects/Crypto/scripts/pairs_bot.py live --env /var/home/acekavi/Projects/Crypto/.env --state /var/home/acekavi/Projects/Crypto/data/pairs_bot_state.json --loop-seconds 60 --log-file /var/home/acekavi/Projects/Crypto/logs/pairs-bot.log --bot-id doge_xrp
Restart=always
RestartSec=10s
NoNewPrivileges=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=crypto-bot

[Install]
WantedBy=default.target
